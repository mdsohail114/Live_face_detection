# Flask
SECRET_KEY=replace-this-with-a-long-random-string
FLASK_DEBUG=1

# Database (optional override)
DATABASE_PATH=instance/emergency_safety.db

# Twilio SMS (leave empty to run in Demo Mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email alerts (leave empty to run in Demo Mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
